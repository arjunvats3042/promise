# Local development only. Copy this file to .env and change the values.
# Docker Compose and Django both read environment variables from .env.
# Do not commit .env.

# Docker infrastructure
POSTGRES_PASSWORD=changeme

# Django application
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://promise:changeme@localhost:5432/promise

REDIS_URL=redis://localhost:6379/0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
