# Local development only. Copy this file to .env and change the values.
# Docker Compose and Django both read environment variables from .env.
# Do not commit .env.

# Docker infrastructure
POSTGRES_PASSWORD=changeme

# Django application
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://promise:changeme@localhost:5432/promise

REDIS_URL=redis://localhost:6379/0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# HMAC pepper for refresh-token secrets. Not a raw token. Change in every environment.
AUTH_REFRESH_TOKEN_PEPPER=changeme

# Fernet key for CURRENT refresh-secret ciphertext (30s grace recovery only).
# Dedicated key. Do not reuse DJANGO_SECRET_KEY, JWT_SIGNING_KEY, or AUTH_REFRESH_TOKEN_PEPPER.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_REFRESH_TOKEN_ENCRYPTION_KEY=changeme

# HS256 access JWTs. Dedicated signing key; do not reuse DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=changeme
JWT_SIGNING_KEY_PREVIOUS=
JWT_KEY_ID=local
JWT_KEY_ID_PREVIOUS=
JWT_ISSUER=promise-api
JWT_AUDIENCE=promise-client
