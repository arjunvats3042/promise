# ==============================================================================
# Promise Production & Local Environment Variables Template
# Copy this file to .env and provide your environment-specific values.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
# In production set: config.settings.production (Local default: config.settings.local)
DJANGO_SETTINGS_MODULE=config.settings.production

# Dedicated Django secret key (50+ random characters)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-in-production-use-a-strong-random-secret

# Must be false in production
DJANGO_DEBUG=false

# Comma-separated list of allowed production domains / hosts
# e.g. api.promise.app,promise-web.up.railway.app
DJANGO_ALLOWED_HOSTS=api.promise.app,promise-web.up.railway.app

# Cross-Origin Resource Sharing (CORS) & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=https://app.promise.app,https://api.promise.app
CSRF_TRUSTED_ORIGINS=https://app.promise.app,https://api.promise.app

# ------------------------------------------------------------------------------
# 2. MANAGED POSTGRESQL DATABASE (Railway PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database
# For SSL in production, append ?sslmode=require
DATABASE_URL=postgresql://promise:password@postgres.railway.internal:5432/promise?sslmode=require

# ------------------------------------------------------------------------------
# 3. MANAGED REDIS (Railway Redis Key-Value)
# ------------------------------------------------------------------------------
# Supports redis:// (plain) or rediss:// (TLS)
REDIS_URL=rediss://default:password@redis.railway.internal:6379/0

# ------------------------------------------------------------------------------
# 4. MANAGED KAFKA (Aiven Kafka)
# ------------------------------------------------------------------------------
# Comma-separated broker host:port endpoints
KAFKA_BOOTSTRAP_SERVERS=kafka-instance.aivencloud.com:19096

# Aiven SASL/SSL Security Configuration
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=aiven-kafka-user
KAFKA_SASL_PASSWORD=aiven-kafka-password
KAFKA_SSL_CA_LOCATION=
# Aiven CA certificate as a PEM string (preferred for Railway/cloud deployments).
# Paste the full contents of the ca.pem file from your Aiven service credentials.
# Priority: KAFKA_SSL_CA_CERT > KAFKA_SSL_CA_LOCATION (file path).
# NEVER commit real certificate values. NEVER log this variable's contents.
KAFKA_SSL_CA_CERT=

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & TOKEN CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# HMAC pepper for refresh-token hashing. Dedicated key. Do not reuse other secrets.
AUTH_REFRESH_TOKEN_PEPPER=change-in-production-refresh-pepper

# Fernet key for active refresh-secret ciphertext (30s grace recovery).
# Dedicated key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_REFRESH_TOKEN_ENCRYPTION_KEY=change-in-production-fernet-key-32-urlsafe-base64=

# HS256 access JWT signing key. Dedicated key.
JWT_SIGNING_KEY=change-in-production-jwt-signing-key
JWT_SIGNING_KEY_PREVIOUS=
JWT_KEY_ID=prod-v1
JWT_KEY_ID_PREVIOUS=
JWT_ISSUER=promise-api
JWT_AUDIENCE=promise-client

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI (Backend Only - 3-Key Fallback Chain)
# ------------------------------------------------------------------------------
GEMINI_API_KEY_1=your-primary-gemini-api-key
GEMINI_API_KEY_2=your-secondary-gemini-api-key
GEMINI_API_KEY_3=your-tertiary-gemini-api-key
GEMINI_DEFAULT_MODEL=gemini-3.7-flash
GEMINI_FAST_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=12
GEMINI_MAX_OUTPUT_TOKENS=1024

# ------------------------------------------------------------------------------
# 7. FIREBASE CLOUD MESSAGING (FCM) & PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Set to true in production when Firebase is configured
FCM_ENABLED=false
FIREBASE_PROJECT_ID=promise-production
# Base64-encoded or inline JSON string of the Firebase service account credential
FIREBASE_CREDENTIALS_JSON=

# ------------------------------------------------------------------------------
# 8. EMAIL SERVICE (Transactional / Verification / Security alerts)
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-smtp-api-key
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Promise <noreply@promise.app>
