def _valid_envelope(**overrides):
    data = {
        "event_id": str(uuid4()),
        "event_type": "commitment.created",
        "event_version": 1,
        "occurred_at": "2026-08-20T18:00:00Z",
        "aggregate_type": "commitment",
        "aggregate_id": str(uuid4()),
        "payload": {"status": "PENDING"},
    }
    data.update(overrides)
    return data


