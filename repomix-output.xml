TEST_ENCRYPTION_KEY = "MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA="
TEST_OTHER_ENCRYPTION_KEY = "MTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTE="
TOKEN_INVALID = {
