package app.promise.android.ui.theme

import androidx.compose.material3.ColorScheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.runtime.ReadOnlyComposable
import androidx.compose.runtime.staticCompositionLocalOf
import androidx.compose.ui.graphics.Color

enum class PromiseThemeMode {
    Light,
    Dark,
}

private val PromiseLightColors = lightColorScheme(
    primary = PromiseColor.Accent,
    onPrimary = PromiseColor.OnAccent,
    secondary = PromiseColor.Secondary,
    onSecondary = PromiseColor.OnPrimary,
    background = PromiseColor.Background,
    onBackground = PromiseColor.TextPrimary,
    surface = PromiseColor.Surface,
    onSurface = PromiseColor.TextPrimary,
    surfaceVariant = PromiseColor.Surface,
    onSurfaceVariant = PromiseColor.TextSecondary,
    error = PromiseColor.Error,
    onError = PromiseColor.OnPrimary,
    outline = PromiseColor.Outline,
    outlineVariant = PromiseColor.Outline,
    scrim = Color(0x66000000),
)

private val PromiseDarkColors = darkColorScheme(
    primary = PromiseDarkColor.Accent,
    onPrimary = PromiseDarkColor.OnAccent,
    secondary = PromiseDarkColor.Secondary,
    onSecondary = PromiseDarkColor.OnPrimary,
    background = PromiseDarkColor.Background,
    onBackground = PromiseDarkColor.TextPrimary,
    surface = PromiseDarkColor.Surface,
    onSurface = PromiseDarkColor.TextPrimary,
    surfaceVariant = PromiseDarkColor.Surface,
    onSurfaceVariant = PromiseDarkColor.TextSecondary,
    error = PromiseDarkColor.Error,
    onError = PromiseDarkColor.OnAccent,
    outline = PromiseDarkColor.Outline,
    outlineVariant = PromiseDarkColor.Outline,
    scrim = Color(0x99000000),
)

data class PromiseExtendedColors(
    val accent: Color,
    val ink: Color,
    val success: Color,
    val warning: Color,
    val textPrimary: Color,
    val textSecondary: Color,
)

private val LightExtended = PromiseExtendedColors(
    accent = PromiseColor.Accent,
    ink = PromiseColor.Primary,
    success = PromiseColor.Success,
    warning = PromiseColor.Warning,
    textPrimary = PromiseColor.TextPrimary,
    textSecondary = PromiseColor.TextSecondary,
)

private val DarkExtended = PromiseExtendedColors(
    accent = PromiseDarkColor.Accent,
    ink = PromiseDarkColor.Primary,
    success = PromiseDarkColor.Success,
    warning = PromiseDarkColor.Warning,
    textPrimary = PromiseDarkColor.TextPrimary,
    textSecondary = PromiseDarkColor.TextSecondary,
)

val LocalPromiseColors = staticCompositionLocalOf { LightExtended }

object PromiseThemeColors {
    val current: PromiseExtendedColors
        @Composable
        @ReadOnlyComposable
        get() = LocalPromiseColors.current
}

@Composable
fun PromiseTheme(
    mode: PromiseThemeMode = PromiseThemeMode.Light,
    content: @Composable () -> Unit,
) {
    val colorScheme: ColorScheme = when (mode) {
        PromiseThemeMode.Light -> PromiseLightColors
        PromiseThemeMode.Dark -> PromiseDarkColors
    }
    val extended = when (mode) {
        PromiseThemeMode.Light -> LightExtended
        PromiseThemeMode.Dark -> DarkExtended
    }
    androidx.compose.runtime.CompositionLocalProvider(LocalPromiseColors provides extended) {
        MaterialTheme(
            colorScheme = colorScheme,
            typography = PromiseTypography,
            shapes = PromiseShapes,
            content = content,
        )
    }
}
</file>

<file path="android/app/src/main/java/app/promise/android/ui/theme/ThemeController.kt">
package app.promise.android.ui.theme

import javax.inject.Inject
import javax.inject.Singleton
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow

@Singleton
class ThemeController @Inject constructor() {
    private val _mode = MutableStateFlow(PromiseThemeMode.Light)
    val mode: StateFlow<PromiseThemeMode> = _mode.asStateFlow()

    fun setMode(mode: PromiseThemeMode) {
        _mode.value = mode
    }

    fun toggle() {
        _mode.value = when (_mode.value) {
            PromiseThemeMode.Light -> PromiseThemeMode.Dark
            PromiseThemeMode.Dark -> PromiseThemeMode.Light
        }
    }
}
</file>

