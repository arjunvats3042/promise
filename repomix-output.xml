        "code": "UNAUTHENTICATED",
        "message": "Authentication failed.",
    }
}
RESPONSE_FIELDS = {
    "id",
    "title",
    "description",
    "status",
    "due_at",
    "due_precision",
    "source",
    "snoozed_until",
    "completed_at",
    "cancelled_at",
    "created_at",
    "updated_at",
    "is_overdue",
}
HIDDEN_FIELDS = {
    "created_by",
    "participants",
    "events",
    "password",
    "metadata",
    "refresh_token_hmac",
}


@pytest.fixture(autouse=True)
def auth_settings(settings):
