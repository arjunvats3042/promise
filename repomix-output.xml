                    shape = RoundedCornerShape(Radius.sm),
                ) {
                    Text(if (submitting) "Saving…" else "Done")
                }
                Spacer(modifier = Modifier.height(Spacing.sm))
                TextButton(
                    onClick = {
                        onSubmit(CheckInInput(status = GoalCheckInStatus.SKIPPED))
